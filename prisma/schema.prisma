generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum MediaType { FILM SERIES GAME BOOK PLAYER }
enum LogStatus { WATCHED STARTED FINISHED COMPLETED ABANDONED FAVORITED DREAM_TEAM }
model User { id String @id @default(cuid()) email String @unique username String @unique name String? createdAt DateTime @default(now()) profile Profile? logs MediaLog[] ratings Rating[] reviews Review[] lists List[] comments Comment[] reactions Reaction[] badges UserBadge[] modules ProfileModule[] guestbookWritten GuestbookEntry[] @relation("GuestbookAuthor") guestbookReceived GuestbookEntry[] @relation("GuestbookOwner") followers Follow[] @relation("following") following Follow[] @relation("follower") }
model Profile { id String @id @default(cuid()) userId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) bio String? bannerUrl String? background String? avatarFrame String? status String? guestbookEnabled Boolean @default(true) }
model Media { id String @id @default(cuid()) type MediaType slug String @unique title String year Int? description String? posterUrl String? metadata Json? movie Movie? series Series? game Game? book Book? player FootballPlayer? logs MediaLog[] ratings Rating[] reviews Review[] listItems ListItem[] }
model Movie { mediaId String @id media Media @relation(fields:[mediaId],references:[id],onDelete:Cascade) director String? runtime Int? }
model Series { mediaId String @id media Media @relation(fields:[mediaId],references:[id],onDelete:Cascade) creators String[] seasons Int? }
model Game { mediaId String @id media Media @relation(fields:[mediaId],references:[id],onDelete:Cascade) developer String? publisher String? platforms String[] }
model Book { mediaId String @id media Media @relation(fields:[mediaId],references:[id],onDelete:Cascade) author String? pages Int? isbn String? }
model FootballPlayer { mediaId String @id media Media @relation(fields:[mediaId],references:[id],onDelete:Cascade) nationality String? position String? clubs String[] }
model MediaLog { id String @id @default(cuid()) userId String mediaId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) media Media @relation(fields:[mediaId],references:[id],onDelete:Cascade) status LogStatus progress Json? loggedAt DateTime @default(now()) }
model Rating { id String @id @default(cuid()) userId String mediaId String value Float favorite Boolean @default(false) user User @relation(fields:[userId],references:[id],onDelete:Cascade) media Media @relation(fields:[mediaId],references:[id],onDelete:Cascade) @@unique([userId,mediaId]) }
model Review { id String @id @default(cuid()) userId String mediaId String body String spoiler Boolean @default(false) createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) media Media @relation(fields:[mediaId],references:[id]) comments Comment[] reactions Reaction[] }
model List { id String @id @default(cuid()) userId String title String description String? user User @relation(fields:[userId],references:[id],onDelete:Cascade) items ListItem[] }
model ListItem { id String @id @default(cuid()) listId String mediaId String position Int list List @relation(fields:[listId],references:[id],onDelete:Cascade) media Media @relation(fields:[mediaId],references:[id]) @@unique([listId,position]) }
model Follow { followerId String followingId String follower User @relation("follower",fields:[followerId],references:[id]) following User @relation("following",fields:[followingId],references:[id]) @@id([followerId,followingId]) }
model Reaction { id String @id @default(cuid()) userId String reviewId String kind String user User @relation(fields:[userId],references:[id]) review Review @relation(fields:[reviewId],references:[id]) @@unique([userId,reviewId,kind]) }
model Comment { id String @id @default(cuid()) userId String reviewId String body String createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) review Review @relation(fields:[reviewId],references:[id]) }
model Badge { id String @id @default(cuid()) slug String @unique name String description String icon String users UserBadge[] }
model UserBadge { userId String badgeId String earnedAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) badge Badge @relation(fields:[badgeId],references:[id]) @@id([userId,badgeId]) }
model ProfileModule { id String @id @default(cuid()) userId String type String position Int size String settings Json visible Boolean @default(true) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,position]) }
model GuestbookEntry { id String @id @default(cuid()) ownerId String authorId String body String approved Boolean @default(true) createdAt DateTime @default(now()) owner User @relation("GuestbookOwner",fields:[ownerId],references:[id]) author User @relation("GuestbookAuthor",fields:[authorId],references:[id]) }
